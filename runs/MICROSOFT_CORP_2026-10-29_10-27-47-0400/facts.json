  "release_lines": {
    "revenue_candidates": [
      {
        "line": 10,
        "text": "Revenue was $92.3 billion and increased 19%"
      },
      {
        "line": 20,
        "text": "\u201cWe delivered a strong start to the fiscal year with Microsoft Cloud revenue of $63.9 billion, with growth accelerating to 30% (up 31% in constant currency) year-over-year,\u201d said Amy Hood, executive vice president and chief financial officer of Microsoft. \u201cResults exceeded expectations across revenue, operating income, and earnings per share.\u201d"
      },
      {
        "line": 130,
        "text": "Revenue in Agents and Infra was $76.8 billion and increased 25%, with the following business highlights:"
      },
      {
        "line": 134,
        "text": "Microsoft Cloud revenue was $63.9 billion and increased 30% (up 31% in constant currency)"
      },
      {
        "line": 136,
        "text": "Azure revenue increased 48%"
      },
      {
        "line": 138,
        "text": "Microsoft 365 commercial cloud revenue increased 18% (up 19% in constant currency) on an adjusted basis, normalized for a 1-point benefit from in-period revenue recognition in the prior year, and increased 17% (up 18% in constant currency) on a reported basis"
      },
      {
        "line": 140,
        "text": "Microsoft 365 consumer cloud revenue increased 17% (up 16% in constant currency)"
      },
      {
        "line": 142,
        "text": "Industry solutions cloud revenue increased 10%"
      },
      {
        "line": 143,
        "text": "Revenue in Devices and Consumer was $15.5 billion and decreased 3%, with the following business highlights:"
      },
      {
        "line": 145,
        "text": "Search and advertising revenue excluding traffic acquisition costs increased 12%"
      },
      {
        "line": 147,
        "text": "XBOX content and services revenue decreased 2% (down 1% in constant currency)"
      },
      {
        "line": 149,
        "text": "Windows OEM and Devices revenue decreased 22%"
      }
    ],
    "diluted_eps_candidates": [
      {
        "line": 16,
        "text": "Diluted earnings per share was $4.92 and increased 32% on a GAAP basis, and was $4.89 and increased 18% (up 19% in constant currency) on a non-GAAP basis"
      },
      {
        "line": 103,
        "text": "Diluted earnings per share"
      },
      {
        "line": 159,
        "text": "Impact from investments in OpenAI. In the first quarter of fiscal year 2027, net income and diluted earnings per share were impacted by net gains from investments in OpenAI, which resulted in an increase in net income and diluted earnings per share of $207 million and $0.03, respectively. In the first quarter of fiscal year 2026, net income and diluted earnings per share were impacted by net losses from investments in OpenAI, which resulted in a decrease in net income and diluted earnings per share of $3.1 billion and $0.41, respectively."
      },
      {
        "line": 279,
        "text": "Diluted earnings per share"
      }
    ],
